# REQUIRED: token of the SECOND Telegram bot created in @BotFather
TELEGRAM_BOT_TOKEN=replace_with_second_bot_token

# REQUIRED: your Telegram numeric admin ID. It can be the same admin ID as the lifetime bot.
BOT_ADMIN_ID=replace_with_admin_numeric_id

# Use a different port from the lifetime bot if both run on the same machine.
PORT=8081
NODE_ENV=production
LOG_LEVEL=info
