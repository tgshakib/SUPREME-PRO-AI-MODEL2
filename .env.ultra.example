# Ultra God Engine — Environment Variables
# Copy relevant lines into Replit Secrets or your .env file
# None of these are required for core operation — all have safe defaults.

# Enable verbose debug logging to console + ultra_engine.log
# Set to "1" to turn on, "0" (default) to run silently
ULTRA_DEBUG=0

# Minimum confidence score (0-100) to accept a signal
# Default: 80 (do not lower below 75 — reduces quality sharply)
ULTRA_MIN_CONFIDENCE=80

# Cooldown duration in minutes after a losing trade per pair
# Default: 5 minutes
ULTRA_COOLDOWN_MINUTES=5

# Allow the engine to infer direction automatically from HTF + regime
# when the caller does not specify "BUY" or "SELL"
# Default: 1 (enabled)
ULTRA_AUTO_DIRECTION=1

# Maximum log file size in bytes before rotation (ultra_engine.log)
# Default: 1000000 (1 MB)
ULTRA_LOG_MAX_BYTES=1000000
